# Cổng dashboard của tool
PORT=7788
# Host bind: 127.0.0.1 (chỉ máy này, an toàn) | 0.0.0.0 (máy khác vào được qua IP)
HOST=127.0.0.1
# Mật khẩu bảo vệ dashboard + /api/* (Basic auth). BẮT BUỘC nên đặt khi HOST=0.0.0.0
# vì dashboard hiển thị token và cho export backup. User để trống, chỉ cần password.
DASHBOARD_PASSWORD=
# Chrome trong container (root): 1 = thêm --no-sandbox. Local để trống.
CHROME_NO_SANDBOX=
# Browser channel: 'chrome' (host macOS, Chrome thật) | 'bundled' (Docker/Linux ARM64, Chromium)
BROWSER_CHANNEL=chrome
# Fingerprint riêng/account (true/false)
FINGERPRINT=true
# Major Chrome thật của máy host (pin để tránh lệch Client Hints)
CHROME_MAJOR=150
# Chu kỳ tự kiểm token health (giờ), 0 = tắt
TOKEN_HEALTH_HOURS=6

# OmniRoute
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_PASSWORD=

# Giãn nhịp giữa 2 account khi Auto Run (giây) — chống checkpoint chain
PACING_MIN_SEC=180
PACING_MAX_SEC=600
# Số account tối đa được login mới trong 24h trên cùng một IP
DAILY_LOGIN_CAP=8

# Thời gian chờ người xử lý challenge trước khi bỏ cuộc (giây)
HUMAN_TIMEOUT_SEC=600

# Mặc định mở trình duyệt hiện hình (headful) cho các bước chạm Google
HEADLESS=false

# ===== Gateway "API proxy AGY" (pool Antigravity → OpenAI-compatible) =====
# Bật gateway (serve /proxy/v1/*). false = tắt.
GATEWAY_ENABLED=true
# Nếu set, tool ngoài phải gửi Authorization: Bearer <key> khi gọi /proxy/v1
GATEWAY_API_KEY=
# Chiến lược xoay account mặc định: round-robin | full-first | failover | highest-first
GATEWAY_ROTATION=round-robin
# Proxy mặc định cho lệnh gọi Antigravity (http://user:pass@host:port). Trống = direct
GATEWAY_PROXY=
# Cooldown (giây) khi account dính 429/hết quota trước khi dùng lại
GATEWAY_COOLDOWN_SEC=900
# Hạn mức Antigravity: auto refresh nền (true/false) + chu kỳ (phút)
GATEWAY_QUOTA_AUTO=false
GATEWAY_QUOTA_INTERVAL_MIN=30
# Cập nhật hạn mức kèm mỗi lần gọi model (true/false) + cache TTL (phút)
GATEWAY_QUOTA_ON_CALL=true
GATEWAY_QUOTA_TTL_MIN=10

# ===== Env bổ sung (đều đổi được trong giao diện Cấu hình) =====
# Thư mục dữ liệu (mặc định ~/.agyproxy, hoặc ./data nếu chạy từ source)
AGY_HOME=
# Tên đăng nhập dashboard (để trống = chấp nhận mọi user)
DASHBOARD_USER=
# OAuth client Antigravity (mặc định dùng client công khai của app)
AGY_CLIENT_ID=
AGY_CLIENT_SECRET=
# Redirect URI cho luồng Kiro
KIRO_REDIRECT_URI=
