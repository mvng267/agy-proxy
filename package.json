{
  "name": "agy-proxy",
  "version": "2.16.2",
  "type": "module",
  "description": "Antigravity gateway: cổng OpenAI-compatible gom pool tài khoản Antigravity + dashboard quản lý",
  "bin": {
    "agyproxy": "bin/agyproxy.mjs"
  },
  "files": [
    "bin",
    "src",
    "public",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/gateway/*.test.ts test/api/*.test.ts test/store/*.test.ts test/health/*.test.ts test/*.test.ts",
    "test:live": "LIVE=1 node --import tsx --test test/live/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.test.ts",
    "install-browser": "playwright install chrome",
    "deploy:web": "scripts/deploy-web.sh",
    "deploy:backend": "scripts/deploy-backend.sh"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fingerprint-generator": "^2.1.86",
    "fingerprint-injector": "^2.1.86",
    "otplib": "^12.0.1",
    "playwright": "^1.50.1",
    "tsx": "^4.19.3",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
