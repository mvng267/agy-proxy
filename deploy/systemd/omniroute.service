[Unit]
Description=OmniRoute — gateway thứ hai, dùng chung pool account với agy-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# KHÔNG đặt `User=` — đây là systemd USER service (~/.config/systemd/user), nó đã chạy
# dưới quyền người dùng hiện tại. User instance không có quyền đổi user/group, nên dòng đó
# làm dịch vụ chết ngay với `Failed at step GROUP ... Operation not permitted` (status
# 216/GROUP) và quay vòng restart vô tận. `User=` chỉ hợp lệ trong system service
# (/etc/systemd/system), nơi systemd chạy bằng root.
WorkingDirectory=%h

Environment=PATH=/home/mvng/.local/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production

# OmniRoute đọc STORAGE_ENCRYPTION_KEY từ đây. Thiếu nó thì token đã mã hoá trong
# storage.sqlite không giải được — dịch vụ lên rồi chết, hoặc chạy mà không đọc nổi
# credential nào. `-` = không có file cũng không sao (lần cài đầu).
EnvironmentFile=-%h/.omniroute/.env

# Đường dẫn tuyệt đối tới bản cài global. Đổi nếu `npm root -g` trả chỗ khác:
#   sudo sed -i "s#/home/mvng/.local/lib/node_modules#$(npm root -g)#" omniroute.service
ExecStart=/home/mvng/.local/node/bin/node /home/mvng/.local/lib/node_modules/omniroute/bin/omniroute.mjs

Restart=on-failure
RestartSec=15
StartLimitBurst=5
StartLimitIntervalSec=600

KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=omniroute

NoNewPrivileges=true
PrivateTmp=true

# `ProtectSystem=full` (chỉ đọc /usr, /boot, /etc) hợp lý, nhưng Next.js còn ghi cache
# vào chính thư mục cài, nên phải mở thêm đường đó — nếu không dịch vụ chết lúc khởi động.
ProtectSystem=full
ReadWritePaths=%h/.omniroute /home/mvng/.local/lib/node_modules/omniroute

[Install]
WantedBy=multi-user.target
